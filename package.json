{
  "name": "prontuario-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node server/index.js\"",
    "web": "vite",
    "api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "npm run build && node e2e/codegen.mjs",
    "lint": "oxlint",
    "preparar-modelos": "node scripts/preparar-modelos.mjs && node scripts/criar-receita-alta.mjs",
    "db:init": "node server/db-init.js",
    "criar-usuario": "node server/criar-usuario.js",
    "demo": "concurrently -k -n web,api \"vite\" \"node server/demo.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "docxtemplater": "^3.71.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

# Copie para .env (que NÃO vai para o Git) e preencha.
# String de conexão do Neon: painel do Neon > Connect > "Pooled connection".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require
# Segredo da sessão: pelo menos 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Administrador criado/atualizado automaticamente na inicialização (opcional com JWT_SECRET).
# Credenciais ficam só no servidor; não use o prefixo VITE_.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador do Hospital
PORT=3001
